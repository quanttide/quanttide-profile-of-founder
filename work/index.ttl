# 工作认知地图 · 知识图谱
#
# 由 work/ 五类档案（触发点 / 情绪 / 方法 / 表达 / 价值）按**事件**重组（原文件已删除，原文基线 `git show 86e8532:work/…`）。
# 对象 = 档案条目，按 kind 归入本命名空间下的类；
# 态射 = 定向关系，用 pf:evokes / pf:responds_to / pf:serves / pf:excludes 表达。
# 语义签名（起点类 → 终点类）：
#   evokes       Event        → Emotion
#   responds_to  Event/Emotion → Method
#   serves       Method       → Value
#   excludes     Value        → Anti
# 数据以 work/（本组）下各档案为准。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:work:profile:> .

########################################
# 本体：类别
########################################

pf:CognitiveMap a rdfs:Class ;
    rdfs:label "认知地图" ;
    rdfs:comment "work 集 profile 的跨日期蒸馏索引：对象 + 态射。" .

pf:Object a rdfs:Class ;
    rdfs:label "对象" ;
    rdfs:comment "认知地图上的一个节点，取自 profile 下各档案的条目。" .

pf:Event      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "事件" .
pf:Emotion    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "情绪" .
pf:Method     a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "方法" .
pf:Expression a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "表达" .
pf:Value      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "价值" .
pf:Anti       a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "排除的形态" .

########################################
# 本体：态射
########################################

pf:evokes a rdf:Property ;
    rdfs:label "触发" ;
    rdfs:comment "事件 → 情绪" ;
    rdfs:domain pf:Event ;
    rdfs:range  pf:Emotion .

pf:responds_to a rdf:Property ;
    rdfs:label "应对" ;
    rdfs:comment "事件（或情绪）→ 方法" ;
    rdfs:range pf:Method .

pf:serves a rdf:Property ;
    rdfs:label "服务于" ;
    rdfs:comment "方法 → 价值" ;
    rdfs:domain pf:Method ;
    rdfs:range  pf:Value .

pf:excludes a rdf:Property ;
    rdfs:label "排除" ;
    rdfs:comment "价值 → 被排除的形态" ;
    rdfs:domain pf:Value ;
    rdfs:range  pf:Anti .

########################################
# 本体：对象属性
########################################

pf:file a rdf:Property ;
    rdfs:label "来源文件" ;
    rdfs:comment "对象在重组前的档案" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

pf:quote a rdf:Property ;
    rdfs:label "出处句" ;
    rdfs:comment "档案原文里的逐字片段" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .


########################################
# 事件组 —— 本文件概括框架，节点定义在各组 ttl
########################################

pf:IssueGroup a rdfs:Class ;
    rdfs:label "事件组" ;
    rdfs:comment "以事件为单位的档案组，见同名 md / lino / ttl。" .

pf:new-requirements a pf:IssueGroup ;
    rdfs:label "目标完成又冒出新需求" ;
    pf:source "work/index.md#目标完成又冒出新需求" ;
    pf:nodes 3 .
pf:stuck-both-sides a pf:IssueGroup ;
    rdfs:label "供需双方都卡住" ;
    pf:source "work/index.md#供需双方都卡住" ;
    pf:nodes 1 .
pf:messy-files a pf:IssueGroup ;
    rdfs:label "文件成了垃圾堆" ;
    pf:source "work/index.md#文件成了垃圾堆" ;
    pf:nodes 3 .
pf:ai-friction a pf:IssueGroup ;
    rdfs:label "AI 用得不顺手" ;
    pf:source "work/index.md#AI 用得不顺手" ;
    pf:nodes 3 .
pf:transition a pf:IssueGroup ;
    rdfs:label "大转型期" ;
    pf:source "work/index.md#大转型期" ;
    pf:nodes 2 .
pf:idea-influx a pf:IssueGroup ;
    rdfs:label "想法不断冒出" ;
    pf:source "work/index.md#想法不断冒出" ;
    pf:nodes 1 .
pf:blocked-expression a pf:IssueGroup ;
    rdfs:label "想法说不出来" ;
    pf:source "work/index.md#想法说不出来" ;
    pf:nodes 2 .
pf:regenerable-material a pf:IssueGroup ;
    rdfs:label "面对高频易再生的素材" ;
    pf:source "work/index.md#面对高频易再生的素材" ;
    pf:nodes 2 .
pf:quick-validation a pf:IssueGroup ;
    rdfs:label "需要快速验证一个想法" ;
    pf:source "work/index.md#需要快速验证一个想法" ;
    pf:nodes 1 .
pf:maintenance-quality a pf:IssueGroup ;
    rdfs:label "维护场景要同时保质量与产出" ;
    pf:source "work/index.md#维护场景要同时保质量与产出" ;
    pf:nodes 2 .
pf:loose-entries a pf:IssueGroup ;
    rdfs:label "不系于事件的条目" ;
    pf:source "work/index.md#不系于事件的条目" ;
    pf:nodes 1 .

########################################
# 跨组的边（节点定义在各自组的 ttl）
########################################
pf:卡住 pf:responds_to pf:先放下 .
