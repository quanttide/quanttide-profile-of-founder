# 带人与标准化 · 知识图谱
#
# 本体与态射定义见 index.ttl；条目原文见 mentoring-standardization.md，边见 mentoring-standardization.lino。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

pf:厌倦与熟练 a pf:Emotion ;
    rdfs:label "厌倦与熟练" ;
    pf:responds_to pf:从依赖个人到依赖规则 .

pf:从依赖个人到依赖规则 a pf:Method ;
    rdfs:label "从依赖个人到依赖规则" .

pf:带人必须有商业收益 a pf:Value ;
    rdfs:label "带人必须有商业收益" ;
    pf:excludes pf:无收益的一对一投入 .

pf:无收益的一对一投入 a pf:Anti ;
    rdfs:label "无收益的一对一投入" .

pf:交给标准化 a pf:Method ;
    rdfs:label "交给标准化" ;
    pf:serves pf:标准化才配走公司流程 .

pf:标准化才配走公司流程 a pf:Value ;
    rdfs:label "标准化才配走公司流程" ;
    pf:excludes pf:个人化表达硬塞进组织流程 .

pf:个人化表达硬塞进组织流程 a pf:Anti ;
    rdfs:label "个人化表达硬塞进组织流程" ;
    pf:quote "把个人化的表达硬塞进组织流程" .
