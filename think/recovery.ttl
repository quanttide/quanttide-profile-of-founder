# 状态与恢复 · 知识图谱
#
# 本体与态射定义见 index.ttl；条目原文见 recovery.md，边见 recovery.lino。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

pf:睡醒时的千头万绪 a pf:Trigger ;
    rdfs:label "睡醒时的千头万绪" ;
    pf:evokes pf:高压与喘息 ;
    pf:responds_to pf:装进框架 .

pf:高压与喘息 a pf:Emotion ;
    rdfs:label "高压与喘息" ;
    pf:responds_to pf:补觉与放手 .

pf:装进框架 a pf:Method ;
    rdfs:label "装进框架" .

pf:补觉与放手 a pf:Method ;
    rdfs:label "补觉与放手" .

pf:进度停滞 a pf:Trigger ;
    rdfs:label "进度停滞" ;
    pf:evokes pf:高压与喘息 ;
    pf:responds_to pf:回到虚构世界 .

pf:连续做复杂思考、人工校形的活儿之后 a pf:Event ;
    rdfs:label "连续做复杂思考、人工校形的活儿之后" ;
    pf:evokes pf:脱力 .

pf:脱力 a pf:Emotion ;
    rdfs:label "脱力" ;
    pf:responds_to pf:先放下 .

pf:发现新需求、与承诺有差距 a pf:Event ;
    rdfs:label "发现新需求、与承诺有差距" ;
    pf:evokes pf:落差 ;
    pf:responds_to pf:先放下 .

pf:落差 a pf:Emotion ;
    rdfs:label "落差" ;
    pf:responds_to pf:先放下 .

pf:先放下 a pf:Method ;
    rdfs:label "先放下" .

pf:卡住 a pf:Emotion ;
    rdfs:label "卡住" ;
    pf:responds_to pf:先放下 .

pf:战略失败 a pf:Trigger ;
    rdfs:label "战略失败" ;
    pf:evokes pf:信心的底色 ;
    pf:responds_to pf:回到虚构世界 .

pf:信心的底色 a pf:Emotion ;
    rdfs:label "信心的底色" .

pf:回到虚构世界 a pf:Method ;
    rdfs:label "回到虚构世界" .

pf:转型期的消耗 a pf:Emotion ;
    rdfs:label "转型期的消耗" ;
    pf:responds_to pf:承认它是转型期常态 .

pf:承认它是转型期常态 a pf:Method ;
    rdfs:label "承认它是转型期常态" .
