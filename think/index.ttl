# think · 知识图谱
#
# 按事情重组的创始人档案：一个事情一组（pf:Matter），
# 条目按 kind 归类（Trigger / Event / Emotion / Method / Expression / Value / Anti）；
# 态射 = 定向关系，用 pf:evokes / pf:responds_to / pf:serves / pf:excludes 表达。
# 语义签名（起点类 → 终点类）：
#   evokes       Trigger/Event → Emotion
#   responds_to  Trigger/Event/Emotion → Method
#   serves       Method       → Value
#   excludes     Value        → Anti
# 本文件收本体、事情节点与跨组边；组内节点与边见各组 ttl。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

########################################
# 本体：类别
########################################

pf:CognitiveMap a rdfs:Class ;
    rdfs:label "认知地图" ;
    rdfs:comment "创始人 profile 的跨日期蒸馏索引：对象 + 态射。" .

pf:Object a rdfs:Class ;
    rdfs:label "对象" ;
    rdfs:comment "认知地图上的一个节点，取自各事情组的条目。" .

pf:Trigger    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "触发点" .
pf:Event      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "事件" .
pf:Emotion    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "情绪" .
pf:Method     a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "方法" .
pf:Expression a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "表达" .
pf:Value      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "价值" .
pf:Anti       a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "排除的形态" .

########################################
# 本体：态射
########################################

pf:evokes a rdf:Property ;
    rdfs:label "触发" ;
    rdfs:comment "触发点 / 事件 → 情绪" ;
    rdfs:domain pf:Trigger ;
    rdfs:range  pf:Emotion .

pf:responds_to a rdf:Property ;
    rdfs:label "应对" ;
    rdfs:comment "情境（触发点 / 事件或情绪）→ 方法" ;
    rdfs:range pf:Method .

pf:serves a rdf:Property ;
    rdfs:label "服务于" ;
    rdfs:comment "方法 → 价值" ;
    rdfs:domain pf:Method ;
    rdfs:range  pf:Value .

pf:excludes a rdf:Property ;
    rdfs:label "排除" ;
    rdfs:comment "价值 → 被排除的形态" ;
    rdfs:domain pf:Value ;
    rdfs:range  pf:Anti .

########################################
# 本体：事情与对象属性
########################################

pf:Matter a rdfs:Class ;
    rdfs:label "事情" ;
    rdfs:comment "正在思考或推动的事情，一个事情一组；情境与事件作为条目挂在事情下。" .

pf:nodes a rdf:Property ;
    rdfs:label "条目数" ;
    rdfs:comment "本事情组的节点数量，与 index.md 一览表一致" ;
    rdfs:domain pf:Matter ;
    rdfs:range  xsd:integer .

pf:quote a rdf:Property ;
    rdfs:label "出处句" ;
    rdfs:comment "档案原文里的逐字片段，用于档案没有独立条目标题、只有描述的对象" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

########################################
# 事情节点 —— 节点与边见各组 ttl
########################################

pf:second-brain a pf:Matter ;
    rdfs:label "第二大脑与档案体系" ;
    pf:nodes 10 .
pf:ai-collaboration a pf:Matter ;
    rdfs:label "与 AI 协作" ;
    pf:nodes 5 .
pf:mentoring-standardization a pf:Matter ;
    rdfs:label "带人与标准化" ;
    pf:nodes 7 .
pf:platform-ecosystem a pf:Matter ;
    rdfs:label "平台与生态" ;
    pf:nodes 7 .
pf:industry-education a pf:Matter ;
    rdfs:label "产教融合与需求众包" ;
    pf:nodes 0 .
pf:writing a pf:Matter ;
    rdfs:label "写作与创作" ;
    pf:nodes 8 .
pf:compliance a pf:Matter ;
    rdfs:label "合规与平台设计" ;
    pf:nodes 3 .
pf:attention-scope a pf:Matter ;
    rdfs:label "注意力与范围" ;
    pf:nodes 6 .
pf:recovery a pf:Matter ;
    rdfs:label "状态与恢复" ;
    pf:nodes 16 .

########################################
# 跨组的边（节点定义在各自组的 ttl）
########################################
pf:不确定是否合规 pf:evokes pf:疏离 .
