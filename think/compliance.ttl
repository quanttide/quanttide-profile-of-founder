# 合规与平台设计 · 知识图谱
#
# 本体与态射定义见 index.ttl；条目原文见 compliance.md，边见 compliance.lino。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

pf:不确定是否合规 a pf:Trigger ;
    rdfs:label "不确定是否合规" ;
    pf:responds_to pf:找合规来套 .

pf:找合规来套 a pf:Method ;
    rdfs:label "找合规来套" .

pf:合规是刚性边界 a pf:Value ;
    rdfs:label "合规是刚性边界" .
