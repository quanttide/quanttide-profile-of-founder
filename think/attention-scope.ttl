# 注意力与范围 · 知识图谱
#
# 本体与态射定义见 index.ttl；条目原文见 attention-scope.md，边见 attention-scope.lino。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

pf:范围失控 a pf:Trigger ;
    rdfs:label "范围失控" ;
    pf:evokes pf:规模焦虑 ;
    pf:responds_to pf:缩小窗口 .

pf:规模焦虑 a pf:Emotion ;
    rdfs:label "规模焦虑" ;
    pf:responds_to pf:缩小窗口 ;
    pf:responds_to pf:去建设平台 .

pf:缩小窗口 a pf:Method ;
    rdfs:label "缩小窗口" ;
    pf:serves pf:积累感 .

pf:去建设平台 a pf:Method ;
    rdfs:label "去建设平台" .

pf:积累感 a pf:Value ;
    rdfs:label "积累感" ;
    pf:excludes pf:消耗型活动 .

pf:消耗型活动 a pf:Anti ;
    rdfs:label "消耗型活动" ;
    pf:quote "消耗型、不留下资产的活动" .
