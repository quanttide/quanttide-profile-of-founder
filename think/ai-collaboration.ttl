# 与 AI 协作 · 知识图谱
#
# 本体与态射定义见 index.ttl；条目原文见 ai-collaboration.md，边见 ai-collaboration.lino。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

pf:AI_变成纯粹执行者 a pf:Trigger ;
    rdfs:label "AI 变成纯粹执行者" ;
    pf:evokes pf:失控与重新掌控 ;
    pf:responds_to pf:刻意引导 .

pf:失控与重新掌控 a pf:Emotion ;
    rdfs:label "失控与重新掌控" ;
    pf:responds_to pf:刻意引导 .

pf:刻意引导 a pf:Method ;
    rdfs:label "刻意引导" ;
    pf:quote "刻意用提示词引导" .

pf:AI_用得不顺手 a pf:Event ;
    rdfs:label "AI 用得不顺手" ;
    pf:responds_to pf:找上下文差异并显性化 .

pf:找上下文差异并显性化 a pf:Method ;
    rdfs:label "找上下文差异并显性化" .
