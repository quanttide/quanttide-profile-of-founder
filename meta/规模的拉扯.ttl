# 认知地图 · 知识图谱
#
# 由 meta/（本组）index.yaml 转换而来（原文件已删除）。
# 对象 = 档案条目，按 kind 归入本命名空间下的类；
# 态射 = 定向关系，用 pf:evokes / pf:responds_to / pf:serves / pf:excludes 表达。
# 语义签名（起点类 → 终点类）：
#   evokes       Trigger      → Emotion
#   responds_to  Trigger/Emotion → Method
#   serves       Method       → Value
#   excludes     Value        → Anti
# 数据以 meta/（本组） 下各档案为准。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

########################################
# 本体：类别
########################################

pf:CognitiveMap a rdfs:Class ;
    rdfs:label "认知地图" ;
    rdfs:comment "default 集 profile 的跨日期蒸馏索引：对象 + 态射。" .

pf:Object a rdfs:Class ;
    rdfs:label "对象" ;
    rdfs:comment "认知地图上的一个节点，取自 profile 下各档案的条目。" .

pf:Trigger    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "触发点" .
pf:Emotion    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "情绪" .
pf:Method     a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "方法" .
pf:Expression a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "表达" .
pf:Value      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "价值" .
pf:Anti       a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "排除的形态" .

########################################
# 本体：态射
########################################

pf:evokes a rdf:Property ;
    rdfs:label "触发" ;
    rdfs:comment "触发点 → 情绪" ;
    rdfs:domain pf:Trigger ;
    rdfs:range  pf:Emotion .

pf:responds_to a rdf:Property ;
    rdfs:label "应对" ;
    rdfs:comment "情境（触发点或情绪）→ 方法" ;
    rdfs:range pf:Method .

pf:serves a rdf:Property ;
    rdfs:label "服务于" ;
    rdfs:comment "方法 → 价值" ;
    rdfs:domain pf:Method ;
    rdfs:range  pf:Value .

pf:excludes a rdf:Property ;
    rdfs:label "排除" ;
    rdfs:comment "价值 → 被排除的形态" ;
    rdfs:domain pf:Value ;
    rdfs:range  pf:Anti .

########################################
# 本体：对象属性
########################################

pf:file a rdf:Property ;
    rdfs:label "来源文件" ;
    rdfs:comment "对象所在的 profile 档案" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

pf:group a rdf:Property ;
    rdfs:label "分组" ;
    rdfs:comment "方法档案内的二级分组" ;
    rdfs:domain pf:Method ;
    rdfs:range  xsd:string .

pf:quote a rdf:Property ;
    rdfs:label "出处句" ;
    rdfs:comment "档案原文里的逐字片段，用于档案没有独立条目标题、只有描述的对象" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

########################################
# 触发点 —— profile/triggers.md
########################################

pf:范围失控 a pf:Trigger ;
    rdfs:label "范围失控" ;
    pf:file "triggers.md" ;
    pf:evokes pf:规模焦虑 ;
    pf:responds_to pf:缩小窗口 .

pf:规模焦虑 a pf:Emotion ;
    rdfs:label "规模焦虑" ;
    pf:file "emotions.md" ;
    pf:responds_to pf:缩小窗口 ;
    pf:responds_to pf:去建设平台 .

pf:缩小窗口 a pf:Method ;
    rdfs:label "缩小窗口" ;
    pf:file "methods.md" ;
    pf:group "思维框架" ;
    pf:serves pf:积累感 .

pf:去建设平台 a pf:Method ;
    rdfs:label "去建设平台" ;
    pf:file "methods.md" ;
    pf:group "应对策略" .

pf:积累感 a pf:Value ;
    rdfs:label "积累感" ;
    pf:file "values.md" ;
    pf:excludes pf:消耗型活动 .

########################################
# 排除的形态 —— profile/values.md「这条线排除的是」
########################################

pf:消耗型活动 a pf:Anti ;
    rdfs:label "消耗型活动" ;
    pf:file "values.md" ;
    pf:quote "消耗型、不留下资产的活动" .
