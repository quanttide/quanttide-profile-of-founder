# 认知地图 · 知识图谱
#
# 由 default/profile/index.yaml 转换而来（原文件已删除）。
# 对象 = 档案条目，按 kind 归入本命名空间下的类；
# 态射 = 定向关系，用 pf:evokes / pf:responds_to / pf:serves / pf:excludes 表达。
# 语义签名（起点类 → 终点类）：
#   evokes       Trigger      → Emotion
#   responds_to  Trigger/Emotion → Method
#   serves       Method       → Value
#   excludes     Value        → Anti
# 数据以 default/profile/ 下各档案为准。

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pf:   <urn:quanttide-context:default:profile:> .

########################################
# 本体：类别
########################################

pf:CognitiveMap a rdfs:Class ;
    rdfs:label "认知地图" ;
    rdfs:comment "default 集 profile 的跨日期蒸馏索引：对象 + 态射。" .

pf:Object a rdfs:Class ;
    rdfs:label "对象" ;
    rdfs:comment "认知地图上的一个节点，取自 profile 下各档案的条目。" .

pf:Trigger    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "触发点" .
pf:Emotion    a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "情绪" .
pf:Method     a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "方法" .
pf:Expression a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "表达" .
pf:Value      a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "价值" .
pf:Anti       a rdfs:Class ; rdfs:subClassOf pf:Object ; rdfs:label "排除的形态" .

########################################
# 本体：态射
########################################

pf:evokes a rdf:Property ;
    rdfs:label "触发" ;
    rdfs:comment "触发点 → 情绪" ;
    rdfs:domain pf:Trigger ;
    rdfs:range  pf:Emotion .

pf:responds_to a rdf:Property ;
    rdfs:label "应对" ;
    rdfs:comment "情境（触发点或情绪）→ 方法" ;
    rdfs:range pf:Method .

pf:serves a rdf:Property ;
    rdfs:label "服务于" ;
    rdfs:comment "方法 → 价值" ;
    rdfs:domain pf:Method ;
    rdfs:range  pf:Value .

pf:excludes a rdf:Property ;
    rdfs:label "排除" ;
    rdfs:comment "价值 → 被排除的形态" ;
    rdfs:domain pf:Value ;
    rdfs:range  pf:Anti .

########################################
# 本体：对象属性
########################################

pf:file a rdf:Property ;
    rdfs:label "来源文件" ;
    rdfs:comment "对象所在的 profile 档案" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

pf:group a rdf:Property ;
    rdfs:label "分组" ;
    rdfs:comment "方法档案内的二级分组" ;
    rdfs:domain pf:Method ;
    rdfs:range  xsd:string .

pf:quote a rdf:Property ;
    rdfs:label "出处句" ;
    rdfs:comment "档案原文里的逐字片段，用于档案没有独立条目标题、只有描述的对象" ;
    rdfs:domain pf:Object ;
    rdfs:range  xsd:string .

########################################
# 触发点 —— profile/triggers.md
########################################

########################################
# 议题组 —— 本文件概括框架，节点定义在各组 ttl
########################################

pf:IssueGroup a rdfs:Class ;
    rdfs:label "议题组" ;
    rdfs:comment "个人议题为单位的档案组，见同名 md / lino / ttl。" .

pf:tension a pf:IssueGroup ;
    rdfs:label "紧张与高压" ;
    pf:source "default/index.md#紧张与高压" ;
    pf:nodes 5 .
pf:strategic-failure a pf:IssueGroup ;
    rdfs:label "战略失败" ;
    pf:source "default/index.md#战略失败" ;
    pf:nodes 3 .
pf:ai-relations a pf:IssueGroup ;
    rdfs:label "AI 关系" ;
    pf:source "default/index.md#AI 关系" ;
    pf:nodes 3 .
pf:scale a pf:IssueGroup ;
    rdfs:label "规模的拉扯" ;
    pf:source "default/index.md#规模的拉扯" ;
    pf:nodes 6 .
pf:alienation a pf:IssueGroup ;
    rdfs:label "疏离" ;
    pf:source "default/index.md#疏离" ;
    pf:nodes 6 .
pf:weariness a pf:IssueGroup ;
    rdfs:label "厌倦" ;
    pf:source "default/index.md#厌倦" ;
    pf:nodes 4 .
pf:value-lines a pf:IssueGroup ;
    rdfs:label "价值线" ;
    pf:source "default/index.md#价值线" ;
    pf:nodes 3 .
pf:loose-entries a pf:IssueGroup ;
    rdfs:label "还散着的条目" ;
    pf:source "default/index.md#还散着的条目" ;
    pf:nodes 10 .

########################################
# 跨组的边（节点定义在各自组的 ttl）
########################################
pf:进度停滞 pf:responds_to pf:回到虚构世界 .
